{
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "4.4.3"
  },
  "description": "Hot Wheels Hunt Book \u2014 a Hot Wheels collection tracker: 5,195-car catalog, ownership / Treasure Hunt tracking, photos, hunt planner, badges, points and Rewards Shop, music player, and video feed. Standalone open-source build (Bun + React + Drizzle + SQLite).",
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.9",
    "bun-plugin-tailwind": "0.0.15",
    "sql.js": "^1.13.0",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3"
  },
  "license": "MIT",
  "name": "hot-wheels-hunt-book",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "build": "bun ./client/build.mjs",
    "build:client": "bun ./client/build.mjs",
    "dev": "bun run server/src/server.ts",
    "start": "bun run server/src/server.ts",
    "typecheck": "bun x tsc --noEmit -p client/tsconfig.json && bun x tsc --noEmit -p server/tsconfig.json",
    "build:android": "bun ./client/build-android.mjs"
  },
  "type": "module",
  "version": "1.0.0"
}
